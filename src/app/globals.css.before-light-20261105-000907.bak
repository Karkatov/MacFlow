@import 'tailwindcss';
@import '../styles/wallspace.css';

@config '../../tailwind.config.ts';

/* Тёмная тема — единственная основная (как на референсе). */
@custom-variant dark (&:is(.dark *));

/* ═══════════════════════════════════════════════════════════════
   Семантические токены, совместимые с существующими страницами.
   Визуальный язык — Wallspace / MacFlow: #111113, крупные радиусы,
   сине-фиолетовый акцент.
   ═══════════════════════════════════════════════════════════════ */

:root {
  --color-cream: #ffffff;
  --color-cream-dark: #f8f9fa;
  --color-night: #111113;
  --color-night-soft: #18181b;
  --color-moonlight: #f5f5f7;

  --brand-from: #6e8efa;
  --brand-via: #6e8efa;
  --brand-to: #a78bfa;
  --brand-glow: rgba(110, 142, 250, 0.35);
  --brand-glow-strong: rgba(110, 142, 250, 0.55);
  --brand-foreground: #a9bcff;
  --brand-strong-from: #6e8efa;
  --brand-strong-via: #7d8ffb;
  --brand-strong-to: #a78bfa;
  --brand-text-from: #8fa8ff;
  --brand-text-via: #6e8efa;
  --brand-text-to: #c4b5fd;

  --background: #2b2b35;
  --background-elevated: #353540;
  --foreground: #f5f5f7;
  --card: #262630;
  --card-foreground: #f5f5f7;
  --popover: #18181b;
  --popover-foreground: #f5f5f7;

  --primary: #f5f5f7;
  --primary-foreground: #08080a;

  --secondary: rgba(255, 255, 255, 0.06);
  --secondary-foreground: #f5f5f7;

  --muted: rgba(255, 255, 255, 0.04);
  --muted-foreground: rgba(245, 245, 247, 0.6);

  --accent: rgba(110, 142, 250, 0.14);
  --accent-foreground: #c7d3ff;

  --destructive: #f87171;
  --destructive-foreground: #1a0a0a;

  --border: rgba(255, 255, 255, 0.08);
  --input: rgba(255, 255, 255, 0.12);
  --ring: #6e8efa;

  --glass-bg: rgba(255, 255, 255, 0.055);
  --glass-border: rgba(255, 255, 255, 0.12);
  --glass-blur: 24px;

  --ease-out-quint: cubic-bezier(0.23, 1, 0.32, 1);
  --hover-shadow-color: var(--brand-glow);

  --tracking-display: -0.03em;
  --tracking-body: -0.01em;

  --text-display-xl: clamp(2.8rem, 7vw, 6rem);
  --text-display-lg: clamp(2.25rem, 5vw, 3.75rem);
  --text-display-md: clamp(1.9rem, 3.6vw, 2.9rem);
  --text-display-sm: clamp(1.5rem, 2.4vw, 2rem);
  --text-lead: clamp(1.125rem, 1.6vw, 1.375rem);
  --text-body: clamp(1rem, 1.1vw, 1.0625rem);
  --text-caption: 0.8125rem;

  color-scheme: dark;
}

/* ═══════════════════════════════════════════════════════════════
   Маппинг токенов в Tailwind-утилиты
   ═══════════════════════════════════════════════════════════════ */

@theme inline {
  --color-background: var(--background);
  --color-background-elevated: var(--background-elevated);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);

  --color-brand: var(--brand-from);
  --color-brand-from: var(--brand-from);
  --color-brand-via: var(--brand-via);
  --color-brand-to: var(--brand-to);
  --color-brand-foreground: var(--brand-foreground);

  --color-night: var(--color-night);
  --color-night-soft: var(--color-night-soft);
  --color-cream: var(--color-cream);
  --color-cream-dark: var(--color-cream-dark);
  --color-moonlight: var(--color-moonlight);

  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  --radius-2xl: clamp(24px, 5vw, 40px);
  --radius-3xl: 32px;

  --font-sans:
    'Inter', 'Inter var', -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display',
    'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  --font-display:
    'Inter', 'Inter var', -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text',
    'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;

  --text-display-xl: var(--text-display-xl);
  --text-display-lg: var(--text-display-lg);
  --text-display-md: var(--text-display-md);
  --text-display-sm: var(--text-display-sm);
  --text-lead: var(--text-lead);
  --text-body: var(--text-body);
  --text-caption: var(--text-caption);

  --ease-out-quint: cubic-bezier(0.23, 1, 0.32, 1);

  --animate-marquee: marquee 32s linear infinite;
  --animate-float: float 9s ease-in-out infinite;
  --animate-shimmer: shimmer 2.4s linear infinite;
  --animate-pulse-glow: pulse-glow 4s ease-in-out infinite;
  --animate-scale-fade-in: scale-fade-in 0.4s var(--ease-out-quint) both;
  --animate-slide-fade-in: slide-fade-in 0.4s var(--ease-out-quint) both;
}

@keyframes marquee {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-14px);
  }
}

@keyframes shimmer {
  from {
    background-position: 200% 0;
  }
  to {
    background-position: -200% 0;
  }
}

@keyframes pulse-glow {
  0%,
  100% {
    opacity: 0.45;
  }
  50% {
    opacity: 0.9;
  }
}

@keyframes scale-fade-in {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes slide-fade-in {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ═══════════════════════════════════════════════════════════════
   Базовые стили
   ═══════════════════════════════════════════════════════════════ */

@layer base {
  * {
    border-color: var(--border);
  }

  html {
    scroll-behavior: smooth;
    -webkit-tap-highlight-color: transparent;
    background-color: var(--bg-primary);
    overflow-x: clip;
  }

  body {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    overflow-x: clip;
    letter-spacing: -0.01em;
  }

  /* Тонкая зернистость как на референсе. */
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity="0"/%3E%3C/svg%3E");
    background-size: 200px 200px;
    background-repeat: repeat;
    z-index: 1;
    opacity: 0.35;
    pointer-events: none;
  }

  ::selection {
    background: var(--brand-glow);
    color: #ffffff;
  }

  :focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: 4px;
  }

  ::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--foreground) 18%, transparent);
    border-radius: 999px;
    border: 2px solid transparent;
    background-clip: content-box;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: color-mix(in srgb, var(--foreground) 32%, transparent);
    background-clip: content-box;
  }
}

/* ═══════════════════════════════════════════════════════════════
   Утилиты
   ═══════════════════════════════════════════════════════════════ */

@layer utilities {
  .text-display-xl,
  .text-display-lg,
  .text-display-md,
  .text-display-sm {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .text-display-xl {
    font-size: var(--text-display-xl);
  }

  .text-display-lg {
    font-size: var(--text-display-lg);
  }

  .text-display-md {
    font-size: var(--text-display-md);
  }

  .text-display-sm {
    font-size: var(--text-display-sm);
  }

  .text-lead {
    font-family: var(--font-sans);
    font-size: var(--text-lead);
    line-height: 1.5;
    letter-spacing: var(--tracking-body);
    text-wrap: pretty;
  }

  .text-body {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: 1.65;
    letter-spacing: var(--tracking-body);
    text-wrap: pretty;
  }

  .text-drop-shadow {
    filter: drop-shadow(0 0 0.5rem rgba(0, 0, 0, 0.5));
  }

  .link-underline {
    position: relative;
  }

  .link-underline::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.15em;
    width: 100%;
    height: 0.055em;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: bottom right;
    transition: transform 0.2s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .link-underline:hover::after,
  .link-underline:focus-visible::after {
    transform: scaleX(1);
    transform-origin: bottom left;
  }

  .hover-glow {
    box-shadow: 0 0 0 0 var(--hover-shadow-color);
    transition:
      box-shadow 0.3s cubic-bezier(0.23, 1, 0.32, 1),
      opacity 0.3s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .hover-glow:hover {
    box-shadow: 0 0 24px 0 var(--hover-shadow-color);
  }

  .marquee-mask {
    mask-image: linear-gradient(90deg, transparent, black 12%, black 88%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 12%, black 88%, transparent);
  }

  .glass {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(180%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(180%);
    border: 1px solid var(--glass-border);
  }

  .glass-strong {
    background: color-mix(in srgb, var(--background) 72%, transparent);
    backdrop-filter: blur(32px) saturate(200%);
    -webkit-backdrop-filter: blur(32px) saturate(200%);
    border: 1px solid var(--glass-border);
  }

  .text-gradient {
    background-image: linear-gradient(
      135deg,
      var(--brand-text-from) 0%,
      var(--brand-text-via) 50%,
      var(--brand-text-to) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .bg-gradient-brand {
    background-image: linear-gradient(
      135deg,
      var(--brand-from) 0%,
      var(--brand-via) 50%,
      var(--brand-to) 100%
    );
  }

  .bg-gradient-brand-strong {
    background-image: linear-gradient(
      135deg,
      var(--brand-strong-from) 0%,
      var(--brand-strong-via) 50%,
      var(--brand-strong-to) 100%
    );
  }

  .glow-brand {
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--brand-via) 22%, transparent),
      0 18px 60px -18px var(--brand-glow);
  }

  .glow-brand-strong {
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--brand-via) 40%, transparent),
      0 26px 80px -20px var(--brand-glow-strong);
  }

  .bg-aurora {
    background-image:
      radial-gradient(60% 55% at 15% 10%, rgba(110, 142, 250, 0.22), transparent 60%),
      radial-gradient(50% 45% at 85% 5%, rgba(167, 139, 250, 0.16), transparent 60%),
      radial-gradient(70% 60% at 50% 100%, rgba(110, 142, 250, 0.14), transparent 65%);
  }

  .bg-grid {
    background-image:
      linear-gradient(
        to right,
        color-mix(in srgb, var(--foreground) 5%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--foreground) 5%, transparent) 1px,
        transparent 1px
      );
    background-size: 56px 56px;
  }

  .mask-fade-b {
    mask-image: linear-gradient(to bottom, black 55%, transparent 100%);
  }

  .mask-fade-x {
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .skeleton {
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--foreground) 6%, transparent) 25%,
      color-mix(in srgb, var(--foreground) 12%, transparent) 37%,
      color-mix(in srgb, var(--foreground) 6%, transparent) 63%
    );
    background-size: 400% 100%;
    animation: var(--animate-shimmer);
  }

  /* Анимации появления из референса (data-атрибуты). */
  [data-animate]:not([data-animate-immediate]) {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-animate]:not([data-animate-immediate]).is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  [data-animate='slide-left']:not([data-animate-immediate]) {
    transform: translate(-40px);
  }

  [data-animate='slide-left']:not([data-animate-immediate]).is-visible {
    transform: translate(0);
  }

  [data-animate='slide-right']:not([data-animate-immediate]) {
    transform: translate(40px);
  }

  [data-animate='slide-right']:not([data-animate-immediate]).is-visible {
    transform: translate(0);
  }

  [data-animate='scale']:not([data-animate-immediate]) {
    transform: scale(0.92);
  }

  [data-animate='scale']:not([data-animate-immediate]).is-visible {
    transform: scale(1);
  }

  [data-animate='fade']:not([data-animate-immediate]) {
    transform: none;
  }

  [data-stagger-child] {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-stagger-child].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Плавная смена страниц. */
::view-transition {
  pointer-events: none;
}

::view-transition-old(root) {
  animation: 160ms cubic-bezier(0.16, 1, 0.3, 1) both vt-fade-out;
}

::view-transition-new(root) {
  animation: 340ms cubic-bezier(0.16, 1, 0.3, 1) both vt-fade-in;
}

@keyframes vt-fade-out {
  to {
    opacity: 0;
  }
}

@keyframes vt-fade-in {
  from {
    opacity: 0;
    transform: translateY(14px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0s !important;
    animation-delay: 0s !important;
  }
}
